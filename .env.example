# Copy to .env and fill in. Never commit .env.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinelai
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-before-deploying
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# API docs at /api/docs: on by default in development, off in production
# ENABLE_DOCS=true

# AI provider: openai or gemini. Keys are backend-only (never prefix with NEXT_PUBLIC_).
# With no key for the chosen provider, AI features are turned off.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Free key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_REQUESTS_PER_HOUR=20
AI_REQUESTS_PER_DAY_SITE_WIDE=250

# Shared with the web app in production; the API then refuses direct calls.
# Leave unset for local development.
# PROXY_SHARED_SECRET=

# Upload limits
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=100000

# --- Frontend ---
# Where Next.js forwards /api/* requests
BACKEND_URL=http://localhost:8000
# Header your host sets to the visitor's real IP (e.g. x-real-ip on Vercel)
# CLIENT_IP_HEADER=
