# Copy to .env and fill in. Never commit .env.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinelai
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
ENABLE_DOCS=true

# OpenAI (backend only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_REQUESTS_PER_HOUR=20

# Upload limits
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=100000

# --- Frontend ---
# Where Next.js forwards /api/* requests
BACKEND_URL=http://localhost:8000
